{
  "name": "signal-chain",
  "description": "Signal Chain — card-chain combat gauntlet (Phaser + React). Packaged for web; Electron/Steam via docs/electron-steam.md.",
  "version": "1.1.0",
  "productName": "Signal Chain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-react-ts.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-react-ts/issues"
  },
  "homepage": "https://github.com/phaserjs/template-react-ts#readme",
  "keywords": [
    "phaser",
    "phaser3",
    "react",
    "vite",
    "typescript"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "electron:start": "npm run build-nolog && electron .",
    "electron:dev": "electron . --dev",
    "electron:pack": "npm run build-nolog && electron-builder",
    "dist:win": "npm run build-nolog && electron-builder --win",
    "dist:mac": "npm run build-nolog && electron-builder --mac",
    "dist:linux": "npm run build-nolog && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-sfx": "node scripts/generate-sfx.mjs",
    "trim-bgm": "node scripts/trim-bgm.mjs",
    "sync-fonts": "node scripts/sync-ui-fonts.mjs",
    "generate-steam-art": "node scripts/generate-steam-art.mjs",
    "postinstall": "node scripts/sync-ui-fonts.mjs"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.3",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.signalchain.game",
    "productName": "Signal Chain",
    "copyright": "Copyright © Signal Chain",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
