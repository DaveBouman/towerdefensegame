{
  "name": "signal-chain",
  "description": "Signal Chain — card-chain combat gauntlet (Phaser + React). Packaged for web; Electron/Steam via docs/electron-steam.md.",
  "version": "1.1.0",
  "productName": "Signal Chain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-react-ts.git"
  },
